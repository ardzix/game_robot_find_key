{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Robot Cari Kunci — 50 level, konfigurasi kelas versi 1",
  "description": "Schema disertakan lokal. URL $schema hanya penanda standar; browser tidak mengambilnya. Runtime engine.js memvalidasi panjang hasil loop maksimal 256 dan posisi awal yang sesuai level. Default merupakan usulan persiapan, bukan keputusan anak.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "levelId",
    "queue",
    "playMode",
    "musicVolume",
    "effectsVolume",
    "muted"
  ],
  "$defs": {
    "command": {
      "type": "string",
      "enum": [
        "forward",
        "left",
        "right",
        "take",
        "open"
      ]
    },
    "repeatBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat",
        "commands"
      ],
      "properties": {
        "repeat": {
          "type": "integer",
          "enum": [
            2,
            3,
            4
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      },
      "description": "Ulangi tersedia hanya level 31–50 (SD 4–6). Tidak bersarang. Setiap perintah di dalamnya tetap satu langkah eksekusi."
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "levelId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "description": "Memilih satu dari 50 peta tetap dan mereset posisi, kunci, peti, serta penunjuk program."
    },
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "dir",
        "hasKey",
        "won"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "dir": {
          "enum": [
            "N",
            "E",
            "S",
            "W"
          ]
        },
        "hasKey": {
          "const": false
        },
        "won": {
          "const": false
        }
      },
      "description": "Metadata opsional yang wajib cocok dengan posisi tetap level. Hilangkan field ini saat mengganti level; validator akan mengisinya. Bukan pemindahan robot bebas."
    },
    "queue": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/command"
          },
          {
            "$ref": "#/$defs/repeatBlock"
          }
        ]
      },
      "description": "Maksimal 64 kartu/blok di baris program, maksimal 256 instruksi biasa setelah Ulangi dibentangkan. Antrean kosong atau rute keliru boleh diuji sebagai proses belajar. Menerapkan konfigurasi tidak menjalankan program otomatis."
    },
    "playMode": {
      "type": "string",
      "enum": [
        "sequence",
        "step"
      ],
      "description": "sequence menjalankan program berurutan; step menjalankan satu instruksi biasa, termasuk satu isi Ulangi, setiap tindakan guru."
    },
    "musicVolume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Volume musik saja."
    },
    "effectsVolume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Volume efek saja."
    },
    "muted": {
      "type": "boolean",
      "description": "Membisukan seluruh suara tanpa mengubah dua nilai volume."
    }
  },
